{
  "name": "verigood-verilog-formatter",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.9.0",
  "publisher": "FabioOliveira",
  "icon": "icon.png",
  "author": {
    "name": "fabiodao"
  },
  "homepage": "https://github.com/fabiodao/VeriGood-verilog_formatter#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fabiodao/VeriGood-verilog_formatter.git"
  },
  "bugs": {
    "url": "https://github.com/fabiodao/VeriGood-verilog_formatter/issues"
  },
  "license": "MIT",
  "keywords": [
    "verilog",
    "systemverilog",
    "formatter",
    "beautifier",
    "hdl",
    "hardware",
    "rtl",
    "fpga",
    "asic",
    "code-formatter",
    "verilog-formatter",
    "systemverilog-formatter"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Formatters",
    "Programming Languages"
  ],
  "localizations": [
    {
      "language": "zh-cn",
      "translations": [
        {
          "id": "vscode.extension.displayName",
          "path": "./package.nls.zh-cn.json"
        }
      ]
    }
  ],
  "activationEvents": [
    "onLanguage:verilog",
    "onLanguage:systemverilog"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "verigood-fmt": "./bin/verigood-fmt.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "verilog",
        "extensions": [
          ".v",
          ".vh"
        ],
        "aliases": [
          "Verilog"
        ]
      },
      {
        "id": "systemverilog",
        "extensions": [
          ".sv",
          ".svh"
        ],
        "aliases": [
          "SystemVerilog"
        ]
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "verilogFormatter.indentSize": {
          "type": "number",
          "default": 2,
          "description": "%indentSize.description%"
        },
        "verilogFormatter.maxBlankLines": {
          "type": "number",
          "default": 1,
          "description": "%maxBlankLines.description%"
        },
        "verilogFormatter.alignPortList": {
          "type": "boolean",
          "default": true,
          "description": "%alignPortList.description%"
        },
        "verilogFormatter.alignParameters": {
          "type": "boolean",
          "default": true,
          "description": "%alignParameters.description%"
        },
        "verilogFormatter.wrapPortList": {
          "type": "boolean",
          "default": true,
          "description": "%wrapPortList.description%"
        },
        "verilogFormatter.lineLength": {
          "type": "number",
          "default": 160,
          "description": "%lineLength.description%"
        },
        "verilogFormatter.removeTrailingWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "%removeTrailingWhitespace.description%"
        },
        "verilogFormatter.alignAssignments": {
          "type": "boolean",
          "default": true,
          "description": "%alignAssignments.description%"
        },
        "verilogFormatter.alignWireDeclSemicolons": {
          "type": "boolean",
          "default": true,
          "description": "%alignWireDeclSemicolons.description%"
        },
        "verilogFormatter.commentColumn": {
          "type": "number",
          "default": 0,
          "description": "%commentColumn.description%"
        },
        "verilogFormatter.formatModuleInstantiations": {
          "type": "boolean",
          "default": true,
          "description": "%formatModuleInstantiations.description%"
        },
        "verilogFormatter.formatModuleHeaders": {
          "type": "boolean",
          "default": true,
          "description": "%formatModuleHeaders.description%"
        },
        "verilogFormatter.indentAlwaysBlocks": {
          "type": "boolean",
          "default": true,
          "description": "%indentAlwaysBlocks.description%"
        },
        "verilogFormatter.enforceBeginEnd": {
          "type": "boolean",
          "default": true,
          "description": "%enforceBeginEnd.description%"
        },
        "verilogFormatter.indentCaseStatements": {
          "type": "boolean",
          "default": true,
          "description": "%indentCaseStatements.description%"
        },
        "verilogFormatter.annotateIfdefComments": {
          "type": "boolean",
          "default": true,
          "description": "%annotateIfdefComments.description%"
        },
        "verilogFormatter.enableUVMFormatting": {
          "type": "boolean",
          "default": true,
          "description": "%enableUVMFormatting.description%"
        },
        "verilogFormatter.uvmLineLength": {
          "type": "number",
          "default": 100,
          "description": "%uvmLineLength.description%"
        },
        "verilogFormatter.expandSingleLineModules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%expandSingleLineModules.description%"
        },
        "verilogFormatter.collapseSingleLineModules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%collapseSingleLineModules.description%"
        },
        "verilogFormatter.preserveInstantiationStyle": {
          "type": "boolean",
          "default": false,
          "description": "%preserveInstantiationStyle.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p .",
    "watch": "tsc -w -p .",
    "test:generate": "npm run compile && node tests/generate_expected.js",
    "test": "npm run compile && node tests/run_tests.js",
    "format": "node bin/verigood-fmt.js",
    "format:check": "node bin/verigood-fmt.js --check",
    "build:cli": "npm run compile && node esbuild.config.js",
    "prepackage": "npm test",
    "package": "vsce package",
    "prepublish": "npm test",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.105.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  }
}
