# Source & build config (only compiled dist/ is shipped)
src/**
**/*.ts
**/*.map
**/tsconfig.json
**/.eslintrc.json
!dist/**/*.js

# Editor / tooling
.vscode/**
.vscode-test/**
.gitignore
.yarnrc
vsc-extension-quickstart.md

# Test suite and local debug/scratch scripts (never shipped)
tests/**
test_*.js
test_*.v
check_*.js

# Development notes not needed in the packaged extension
RELEASE_*.md
LOGGING_SYSTEM.md

# Dependencies & build artifacts
node_modules/**
*.vsix
.reasonix/**
